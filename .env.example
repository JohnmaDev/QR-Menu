# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - QR MENU (EJEMPLO / TEMPLATE)
# COPIAR A .env Y COMPLETAR CON VALORES CORRESPONDIENTES.
# NUNCA SUBIR EL ARCHIVO .env REAL AL CONTROL DE VERSIONES.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base de datos PostgreSQL (Neon / Supabase / Local)
# Para desarrollo local rápido sin necesidad de instalar PostgreSQL ni Docker, usar:
DATABASE_URL=pglite://.pgdata
# O bien apuntar a un PostgreSQL estándar:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qr_menu_dev?sslmode=disable

# Clave secreta para firma de cookies de sesión administrativa (OBLIGATORIA en producción, mínimo 32 caracteres aleatorios)
SESSION_SECRET=super_secret_session_key_replace_with_min_32_chars_random_string

# Reverse Proxy Trust (SEC-04): false (default), true (para PaaS administrados), o lista de IPs/CIDR separadas por coma
TRUST_PROXY=false

# Dominio autorizado para CORS (Frontend)
CORS_ORIGIN=http://localhost:5173

# Cloudinary (Almacenamiento y optimización de imágenes)
CLOUDINARY_CLOUD_NAME=mock_cloud_name
CLOUDINARY_API_KEY=mock_api_key
CLOUDINARY_API_SECRET=mock_api_secret

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# URL base pública de la API REST
VITE_API_BASE_URL=http://localhost:3000
